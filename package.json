{
  "name": "eslint-plugin-anti-slop",
  "version": "0.1.0",
  "type": "module",
  "description": "Config-driven anti-slop ESLint rules for React/TypeScript projects.",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./audit": "./src/audit.mjs",
    "./audit-formatter": "./src/audit-formatter.mjs",
    "./cli": "./src/cli.mjs",
    "./gate": "./src/gate.mjs",
    "./rule-metadata": "./src/rule-metadata.mjs"
  },
  "bin": {
    "anti-slop": "./bin/anti-slop.mjs"
  },
  "files": [
    "bin",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=src/**/*.mjs --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.mjs",
    "smoke:consumer": "pnpm --dir smoke-consumer install --frozen-lockfile && pnpm --dir smoke-consumer lint && pnpm --dir smoke-consumer quality:anti-slop",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "pnpm audit --audit-level high",
    "verify": "pnpm test && pnpm test:coverage && pnpm smoke:consumer && pre-cr run --workspace . && pnpm pack --pack-destination /private/tmp"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react",
    "typescript",
    "ui-quality"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jakyeamos/eslint-plugin-anti-slop.git"
  },
  "bugs": {
    "url": "https://github.com/jakyeamos/eslint-plugin-anti-slop/issues"
  },
  "homepage": "https://github.com/jakyeamos/eslint-plugin-anti-slop#readme",
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.29.0"
  },
  "license": "MIT"
}
