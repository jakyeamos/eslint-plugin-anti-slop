{
  "name": "eslint-plugin-anti-slop",
  "version": "0.1.0",
  "type": "module",
  "description": "Config-driven anti-slop ESLint rules for React/TypeScript projects.",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "verify": "pnpm test && pnpm test:coverage && pre-cr run --workspace . && pnpm pack --pack-destination /private/tmp"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react",
    "typescript",
    "ui-quality"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jakyeamos/eslint-plugin-anti-slop.git"
  },
  "bugs": {
    "url": "https://github.com/jakyeamos/eslint-plugin-anti-slop/issues"
  },
  "homepage": "https://github.com/jakyeamos/eslint-plugin-anti-slop#readme",
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.29.0"
  },
  "license": "MIT"
}
