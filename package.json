{
  "name": "eslint-plugin-anti-slop",
  "version": "0.2.0",
  "type": "module",
  "description": "Config-driven anti-slop ESLint rules for React/TypeScript projects.",
  "packageManager": "pnpm@11.7.0",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./audit": "./src/audit.mjs",
    "./aios-audit-config": "./src/aios-audit-config.mjs",
    "./audit-formatter": "./src/audit-formatter.mjs",
    "./audit-formatter.mjs": "./audit-formatter.mjs",
    "./cli": "./src/cli.mjs",
    "./gate": "./src/gate.mjs",
    "./rule-metadata": "./src/rule-metadata.mjs"
  },
  "bin": {
    "anti-slop": "./bin/anti-slop.mjs"
  },
  "files": [
    "audit-formatter.mjs",
    "bin",
    "eslint.aios-audit.config.mjs",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "audit:anti-slop": "eslint . --config eslint.aios-audit.config.mjs --format ./audit-formatter.mjs",
    "format": "node scripts/format-check.mjs",
    "typecheck": "node scripts/check-js-syntax.mjs typecheck",
    "build": "pnpm pack --dry-run",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=src/**/*.mjs --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.mjs",
    "audit:dead-code": "node scripts/dead-code-check.mjs",
    "smoke": "pnpm smoke:consumer",
    "smoke:eslint9": "pnpm --dir smoke-consumer install --frozen-lockfile --force && pnpm --dir smoke-consumer lint && pnpm --dir smoke-consumer quality:anti-slop && pnpm --dir smoke-consumer audit:anti-slop",
    "smoke:consumer": "pnpm smoke:eslint9",
    "smoke:published": "node scripts/smoke-published.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "node scripts/dependency-security.mjs",
    "verify": "pnpm test && pnpm test:coverage && pnpm smoke:consumer && pnpm smoke:published",
    "verify:local": "pnpm verify && pre-cr run --workspace ."
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react",
    "typescript",
    "ui-quality"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jakyeamos/eslint-plugin-anti-slop.git"
  },
  "bugs": {
    "url": "https://github.com/jakyeamos/eslint-plugin-anti-slop/issues"
  },
  "homepage": "https://github.com/jakyeamos/eslint-plugin-anti-slop#readme",
  "peerDependencies": {
    "eslint": ">=9.0.0 <10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.29.0"
  },
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/parser": "^8.62.0",
    "picomatch": "^4.0.5"
  }
}
