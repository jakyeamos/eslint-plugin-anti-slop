{
  "version": 1,
  "testCommand": "pnpm test:coverage",
  "coveragePaths": [
    "coverage/lcov.info",
    "coverage/coverage-final.json",
    ".nyc_output/coverage.json",
    "coverage.lcov",
    "lcov.info",
    "coverage.out"
  ],
  "coverageFormat": "auto",
  "qualityAdapters": [
    {
      "name": "environment-contract",
      "command": "node scripts/check_environment_contract.mjs",
      "required": true
    }
  ],
  "surfaces": {
    "covered": [
      "src/**"
    ],
    "ignored": [
      ".github/**",
      ".gitignore",
      ".pre-cr.json",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "README.md",
      "AGENTS.md",
      "docs/**",
      "package.json",
      ".planning/**",
      "pnpm-lock.yaml",
      "test/**"
    ],
    "unsupported": []
  },
  "threshold": 80,
  "checks": {
    "coverage": true,
    "security": true,
    "checklist": true
  }
}
